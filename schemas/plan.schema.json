{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "medium": {
      "const": "html"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "colorScheme": {
            "enum": [
              "light",
              "dark"
            ]
          }
        },
        "required": [
          "id",
          "width",
          "height",
          "colorScheme"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "check": {
                "const": "viewport-overflow"
              }
            },
            "required": [
              "id",
              "check"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "check": {
                "const": "visible-text"
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "check",
              "selector",
              "text"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "check": {
                "const": "text-contrast"
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "minRatio": {
                "type": "number",
                "minimum": 1,
                "maximum": 21
              }
            },
            "required": [
              "id",
              "check",
              "selector",
              "minRatio"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "check": {
                "const": "style-equals"
              },
              "selector": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "property": {
                "enum": [
                  "color",
                  "background-color",
                  "font-family",
                  "font-size",
                  "font-weight",
                  "line-height",
                  "letter-spacing",
                  "text-align"
                ]
              },
              "expected": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "check",
              "selector",
              "property",
              "expected"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "medium",
    "environments",
    "requirements"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GDC-0 HTML verification plan",
  "description": "Consumers additionally enforce unique environment and requirement IDs and non-whitespace strings."
}
