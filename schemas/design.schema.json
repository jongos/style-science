{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jongos.github.io/style-science/schemas/design.schema.json",
  "title": "GDC Experimental Design Language 0.1.0",
  "description": "Structural schema only. validateDesign additionally checks IDs, endpoints, containment parents and cycles. Conformance does not establish rendered or aesthetic quality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["languageVersion", "id", "revision", "context", "nodes", "relations"],
  "properties": {
    "languageVersion": {"const": "0.1.0"},
    "id": {"$ref": "#/$defs/text"},
    "revision": {"$ref": "#/$defs/text"},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "audience", "medium", "intent"],
      "properties": {
        "task": {"$ref": "#/$defs/text"}, "audience": {"$ref": "#/$defs/text"},
        "medium": {"$ref": "#/$defs/text"}, "intent": {"$ref": "#/$defs/text"}
      }
    },
    "nodes": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "role", "tokenRefs"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "role": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["group", "text", "image", "action", "data"]},
          "tokenRefs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "relations": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "from", "to"],
        "properties": {
          "id": {"$ref": "#/$defs/text"}, "from": {"$ref": "#/$defs/text"}, "to": {"$ref": "#/$defs/text"},
          "kind": {"enum": ["contains", "precedes", "groups-with", "emphasizes"]}
        }
      }
    }
  },
  "$defs": {"text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"}}
}
